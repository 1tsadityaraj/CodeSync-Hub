# API Base URL configuration
# In local development: Leave empty to use the Vite dev proxy (/api -> http://localhost:5001)
# Or specify explicit URL:
VITE_API_URL=http://localhost:5001/api

# Production backend deployment origin (e.g. Render)
VITE_API_BASE_URL=https://codesync-hub-api.onrender.com

# WebRTC STUN/TURN Configuration
# Default STUN server for NAT discovery (defaults to Google's public STUN if unset)
VITE_STUN_SERVER=stun:stun.l.google.com:19302

# Optional TURN Relay Configuration (required when participants are behind restrictive symmetric NATs or corporate firewalls)
# VITE_TURN_SERVER=turn:turn.example.com:3478
# VITE_TURN_USERNAME=your_turn_username
# VITE_TURN_CREDENTIAL=your_turn_credential
